---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { getPublishedWork } from '../utils/getPublishedWork';

const work = (await getPublishedWork()).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="Work">
  <div class="work">
    <section class="work-intro">
      <h1 class="page-title">Work</h1>
      <div class="work-intro__content">
        <p class="work-intro__supporting">
          All projects shown are simplified for public viewing, with full case studies and more projects in progress. Interested in learning more about a specific project?
        </p>
        <a
          href="mailto:hello@miles-anderson.com?subject=Case%20study%20request"
          class="button-accent"
        >
          Request case study
        </a>
      </div>
    </section>

    <ul class="work-grid">
      {
        work.map((entry) => (
          <li>
            <ProjectCard entry={entry} />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
