---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Portfolio">
  <div class="home">
    <section class="home-hero">
      <div class="home-hero__text">
        <p class="home-hero__greeting">Hello.</p>
        <h1 class="home-hero__headline">
          I'm Miles, a product designer and leader with 12+ years bringing
          enterprise systems thinking and consumer craft to products used by
          millions of people.
        </h1>
        <p class="home-hero__supporting">
          Based in the great city of Houston, TX. Most recently led product
          design for the Xbox team at Microsoft as a Design Architect. Currently
          exploring remote or in-person Principal and Staff-level roles.
        </p>
      </div>
      <a href="mailto:letschat@miles-anderson.com" class="button-accent">
        Let's chat
      </a>
    </section>

    <section class="home-section">
      <div class="home-section__header">
        <h2 class="home-section__label">Featured project</h2>
        <a href="/work" class="home-section__link">VIEW ALL</a>
      </div>
      <div class="home-placeholder home-placeholder--featured" aria-hidden="true"></div>
    </section>

    <section class="home-section">
      <div class="home-section__header">
        <h2 class="home-section__label">Featured</h2>
        <a href="#" class="home-section__link">VIEW ALL</a>
      </div>
      <div class="home-grid home-grid--2">
        <div class="home-placeholder" aria-hidden="true"></div>
        <div class="home-placeholder" aria-hidden="true"></div>
      </div>
    </section>

    <section class="home-section">
      <div class="home-section__header">
        <h2 class="home-section__label">Featured</h2>
        <a href="#" class="home-section__link">VIEW ALL</a>
      </div>
      <div class="home-grid home-grid--3">
        <div class="home-placeholder" aria-hidden="true"></div>
        <div class="home-placeholder" aria-hidden="true"></div>
        <div class="home-placeholder" aria-hidden="true"></div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-4xl);
  }

  .home-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    width: 100%;
  }

  .home-hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .home-hero__greeting {
    font-family: var(--font-serif);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-regular);
    color: var(--color-text-primary);
  }

  .home-hero__headline {
    font-family: var(--font-serif);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-light);
    line-height: var(--line-height-normal);
    color: var(--color-text-primary);
  }

  .home-hero__supporting {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-normal);
    color: var(--color-text-secondary);
  }

  .home-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .home-section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .home-section__label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-normal);
  }

  .home-section__link {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .home-placeholder {
    min-height: 240px;
    background: var(--color-surface);
  }

  .home-placeholder--featured {
    min-height: 480px;
  }

  .home-grid {
    display: grid;
    gap: var(--space-lg);
  }

  .home-grid--2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .home-grid--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 767px) {
    .home-hero__greeting {
      font-size: var(--font-size-lg);
    }

    .home-hero__headline {
      font-size: var(--font-size-2xl);
    }
  }
</style>
