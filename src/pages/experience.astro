---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceJobEntry from '../components/ExperienceJobEntry.astro';
import xboxLogo from '../assets/icons/xbox.svg?raw';
import ibmLogo from '../assets/icons/ibm.svg?raw';
import zapposLogo from '../assets/icons/zappos.svg?raw';
---

<BaseLayout title="Experience">
  <div class="experience">
    <section class="experience-intro">
      <h1 class="page-title">Experience</h1>

      <div class="experience-intro__content">
        <p class="experience-intro__supporting">
          More than a decade spent moving between enterprise
          systems and consumer products, leading design for teams shipping to
          millions and building the internal tools that support them. Here's
          how that path has unfolded.
        </p>
      </div>
    </section>

    <section class="experience-jobs">
      <ExperienceJobEntry
        logoSvg={xboxLogo}
        company="Microsoft — Xbox"
        role="Design Architect"
        dates="2020 – 2026"
        description="Design direction for Xbox's flagship mobile app, including end-to-end product direction and delivery through the Series S/X launch and every major feature release since. As Senior Design Manager, led a team of product designers building safe, inclusive, and engaging social experiences across mobile, console, and PC, spanning Xbox's community and family safety functionality. As Design Architect, aligned cross-functional roadmaps and presented strategic initiatives to senior leadership, operating as a hybrid designer and product leader across the org."
      />
      <ExperienceJobEntry
        logoSvg={ibmLogo}
        company="IBM — Cloud & Digital Business Group"
        role="Sr Product Designer"
        dates="2014 – 2020"
        description="DevTools UX for IBM Cloud, setting product direction for developer and DevOps experiences and improving platform usability across the platform. Before that, design and delivery of IBM's first self-service digital marketplace at the Digital Business Group, including the backend management tools built for enterprise customers."
      />
      <ExperienceJobEntry
        logoSvg={zapposLogo}
        company="Zappos — Site Operations"
        role="Visual Designer"
        dates="2012 – 2013"
        description="Web and print marketing assets for Zappos and 6pm, driving seasonal art direction and merchandising goals across both brands."
      />
    </section>
  </div>
</BaseLayout>
