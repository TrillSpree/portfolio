---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceJobEntry from '../components/ExperienceJobEntry.astro';
import xboxLogo from '../assets/icons/xbox.svg?raw';
import ibmLogo from '../assets/icons/ibm.svg?raw';
import zapposLogo from '../assets/icons/zappos.svg?raw';
---

<BaseLayout title="Experience">
  <div class="experience">
    <section class="experience-intro">
      <h1 class="page-title">Experience</h1>

      <div class="experience-intro__content">
        <p class="experience-intro__supporting">
          More than a decade spent moving between enterprise
          systems and consumer products, leading design for teams shipping to
          millions and building the internal tools that support them. Here's
          how that path has unfolded.
        </p>
        <a href="/resume.pdf" class="button-accent">Download resume</a>
      </div>
    </section>

    <section class="experience-jobs">
      <ExperienceJobEntry
        logoSvg={xboxLogo}
        company="Microsoft, Xbox"
        role="Design Architect"
        dates="2020 – 2026"
        description="Led design for the flagship Xbox mobile app, including end-to-end product direction and delivery supporting the Series S/X launch and subsequent feature launches. As Design Architect, influenced product direction and strategy as a hybrid designer and product leader, by aligning cross-functional roadmaps and presenting strategic initiatives to senior leadership."
      />
      <ExperienceJobEntry
        logoSvg={ibmLogo}
        company="IBM, Cloud"
        role="Product Designer"
        dates="2014 – 2020"
        description="Led DevTools UX for IBM Cloud, defining product direction for developer and DevOps experiences and improving platform usability across the board. Earlier, designed IBM's first self-service digital marketplace, including the backend management tools built for enterprise customers."
      />
      <ExperienceJobEntry
        logoSvg={zapposLogo}
        company="Zappos"
        role="Visual Designer"
        dates="2012 – 2013"
        description="Produced web and print marketing assets for Zappos and 6pm, driving seasonal art direction and merchandising goals."
      />
    </section>

    <section class="experience-testimonials">
      <h2 class="experience-section__heading">Testimonials</h2>
      <div class="experience-grid experience-grid--3">
        <div class="experience-placeholder" aria-hidden="true"></div>
        <div class="experience-placeholder" aria-hidden="true"></div>
        <div class="experience-placeholder" aria-hidden="true"></div>
      </div>
    </section>
  </div>
</BaseLayout>
