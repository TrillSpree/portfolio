---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  layout?: 'default' | 'wide' | 'narrow';
}

const {
  title = 'Portfolio',
  description = '',
  layout = 'default',
} = Astro.props;

const layoutClass =
  layout === 'wide'
    ? 'layout layout--wide'
    : layout === 'narrow'
      ? 'layout layout--narrow'
      : 'layout';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="site">
    <Header />

    <main class="site-main">
      <div class={layoutClass}>
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>
