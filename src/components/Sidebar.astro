---
import logo from '../assets/logo-lockup.svg';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  { href: '/experience', label: 'Experience' },
  { href: '/about', label: 'About' },
];
---

<aside class="site-sidebar">
  <div class="site-sidebar__top">
    <a href="/" class="site-sidebar__logo">
      <img
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt="Miles Anderson"
      />
    </a>

    <button
      type="button"
      class="site-sidebar__toggle"
      aria-expanded="false"
      aria-controls="site-sidebar-nav"
      aria-label="Menu"
    >
      <span class="site-sidebar__toggle-bar" aria-hidden="true"></span>
      <span class="site-sidebar__toggle-bar" aria-hidden="true"></span>
      <span class="site-sidebar__toggle-bar" aria-hidden="true"></span>
    </button>
  </div>

  <nav class="site-sidebar__nav" id="site-sidebar-nav" aria-label="Primary">
    <ul class="site-sidebar__nav-list">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class="site-sidebar__nav-link">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<script>
  const sidebar = document.querySelector('.site-sidebar');
  const toggle = document.querySelector('.site-sidebar__toggle');
  const nav = document.querySelector('#site-sidebar-nav');

  if (sidebar && toggle && nav) {
    toggle.addEventListener('click', () => {
      const isOpen = sidebar.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        sidebar.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
