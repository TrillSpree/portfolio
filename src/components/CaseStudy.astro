---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import expandIcon from '../assets/icons/expand.svg?raw';
import MarkdownProse from './MarkdownProse.astro';
import PrinciplesCards from './PrinciplesCards.astro';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const {
  title,
  headline,
  description,
  role,
  releaseDate,
  press,
  image,
  gallery,
  impact,
  problem,
  explorations,
  principles,
  solution,
  opportunity,
  takeaway,
} = entry.data;

const galleryImages = gallery
  ? gallery.map((image) => ({
      image,
      fullSrc: image.src,
    }))
  : [];

const heroFullSrc = image?.src;

const explorationsBlocks = explorations
  ? explorations.trim().split(/\n\n+/).filter(Boolean)
  : [];
const explorationsLeadCount =
  principles && principles.length > 0 ? 2 : explorationsBlocks.length;
const explorationsLead = explorationsBlocks.slice(0, explorationsLeadCount).join('\n\n');
const explorationsRest = explorationsBlocks.slice(explorationsLeadCount).join('\n\n');
---

<article class="case-study">
  <header class="case-study__header">
    <p class="page-title">{title}</p>
    <h1 class="case-study__title">{headline}</h1>
    <p class="case-study__description">{description}</p>
  </header>

  {
    image && (
      <div class="case-study__hero case-study__gallery-item" data-full-src={heroFullSrc}>
        <Image class="case-study__hero-image" src={image} alt="" />
        {heroFullSrc && (
          <button
            type="button"
            class="case-study__gallery-expand"
            data-full-src={heroFullSrc}
            aria-label="Expand image"
          >
            <span class="case-study__gallery-expand-icon" set:html={expandIcon} />
          </button>
        )}
      </div>
    )
  }

  <div class="case-study-meta">
    <div class="case-study-meta__column">
      <h2 class="case-study-meta__heading">Release date</h2>
      <p class="case-study-meta__value">{releaseDate}</p>
    </div>

    <div class="case-study-meta__column">
      <h2 class="case-study-meta__heading">Role</h2>
      <ul class="case-study-meta__list">
        {role.map((item) => <li class="case-study-meta__role">{item}</li>)}
      </ul>
    </div>

    {
      press && press.length > 0 && (
        <div class="case-study-meta__column case-study-meta__column--press">
          <h2 class="case-study-meta__heading">Press</h2>
          <ul class="case-study-meta__list">
            {press.map((item) => (
              <li class="case-study-meta__item">
                <span class="case-study-meta__label">{item.publication}</span>
                {item.url ? (
                  <a
                    href={item.url}
                    class="case-study-meta__name case-study-meta__link"
                    title={item.articleTitle}
                  >
                    {item.articleTitle}
                  </a>
                ) : (
                  <span class="case-study-meta__name" title={item.articleTitle}>
                    {item.articleTitle}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  {
    gallery && gallery.length > 0 && (
      <div
        class:list={[
          'case-study__gallery',
          { 'case-study__gallery--multiple': gallery.length > 1 },
        ]}
      >
        {galleryImages.map(({ image, fullSrc }) => (
          <div class="case-study__gallery-item" data-full-src={fullSrc}>
            <Image class="case-study__gallery-image" src={image} alt="" />
            <button
              type="button"
              class="case-study__gallery-expand"
              data-full-src={fullSrc}
              aria-label="Expand image"
            >
              <span class="case-study__gallery-expand-icon" set:html={expandIcon} />
            </button>
          </div>
        ))}
      </div>
    )
  }

  {
    problem && (
      <section class="case-study-section">
        <h2 class="case-study-section__heading">Problem</h2>
        <MarkdownProse content={problem} />
      </section>
    )
  }

  {
    (explorations || (principles && principles.length > 0)) && (
      <section class="case-study-section">
        <h2 class="case-study-section__heading">Explorations</h2>
        {explorationsLead && <MarkdownProse content={explorationsLead} />}
        {principles && principles.length > 0 && (
          <PrinciplesCards principles={principles} />
        )}
        {explorationsRest && <MarkdownProse content={explorationsRest} />}
      </section>
    )
  }

  {
    solution && (
      <section class="case-study-section">
        <h2 class="case-study-section__heading">Solution</h2>
        <MarkdownProse content={solution} />
      </section>
    )
  }

  {
    opportunity && (
      <section class="case-study-section">
        <h2 class="case-study-section__heading">Opportunity</h2>
        <MarkdownProse content={opportunity} />
      </section>
    )
  }

  {
    impact && impact.length > 0 && (
      <aside class="case-study-impact" aria-label="Impact">
        <h2 class="case-study-impact__heading">Impact</h2>
        <ul class="case-study-impact__list">
          {impact.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </aside>
    )
  }

  {
    takeaway && (
      <section class="case-study-section">
        <h2 class="case-study-section__heading">Takeaway</h2>
        <MarkdownProse content={takeaway} />
      </section>
    )
  }
</article>
