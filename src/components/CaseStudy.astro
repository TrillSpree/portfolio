---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import MarkdownProse from './MarkdownProse.astro';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const {
  title,
  headline,
  description,
  role,
  releaseDate,
  press,
  gallery,
  impact,
  problem,
  explorations,
  solution,
  takeaway,
} = entry.data;
---

<article class="case-study">
  <header class="case-study__header">
    <p class="page-title">{title}</p>
    <h1 class="case-study__title">{headline}</h1>
    <p class="case-study__description">{description}</p>
  </header>

  <div class="case-study-meta">
    <div class="case-study-meta__column">
      <h2 class="case-study-meta__heading">Role</h2>
      <ul class="case-study-meta__list">
        {role.map((item) => <li class="case-study-meta__role">{item}</li>)}
      </ul>
    </div>

    <div class="case-study-meta__column">
      <h2 class="case-study-meta__heading">Release date</h2>
      <p class="case-study-meta__value">{releaseDate}</p>
    </div>

    {
      press && press.length > 0 && (
        <div class="case-study-meta__column case-study-meta__column--press">
          <h2 class="case-study-meta__heading">Press</h2>
          <ul class="case-study-meta__list">
            {press.map((item) => (
              <li class="case-study-meta__item">
                <span class="case-study-meta__label">{item.publication}</span>
                {item.url ? (
                  <a
                    href={item.url}
                    class="case-study-meta__name case-study-meta__link"
                    title={item.articleTitle}
                  >
                    {item.articleTitle}
                  </a>
                ) : (
                  <span class="case-study-meta__name" title={item.articleTitle}>
                    {item.articleTitle}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  {
    gallery && gallery.length > 0 && (
      <div class="case-study__gallery">
        {gallery.map((item) => (
          <Image class="case-study__gallery-image" src={item} alt="" />
        ))}
      </div>
    )
  }

  {
    impact && impact.length > 0 && (
      <aside class="case-study-impact" aria-label="Impact">
        <h2 class="case-study-impact__heading">Impact</h2>
        <ul class="case-study-impact__list">
          {impact.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </aside>
    )
  }

  {
    problem && (
      <section class="case-study-section">
        <h2 class="case-study-section__heading">Problem</h2>
        <MarkdownProse content={problem} />
      </section>
    )
  }

  {
    explorations && (
      <section class="case-study-section">
        <h2 class="case-study-section__heading">Explorations</h2>
        <MarkdownProse content={explorations} />
      </section>
    )
  }

  {
    solution && (
      <section class="case-study-section">
        <h2 class="case-study-section__heading">Solution</h2>
        <MarkdownProse content={solution} />
      </section>
    )
  }

  {
    takeaway && (
      <section class="case-study-section">
        <h2 class="case-study-section__heading">Takeaway</h2>
        <MarkdownProse content={takeaway} />
      </section>
    )
  }
</article>
